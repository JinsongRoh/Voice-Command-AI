#
# Example systemd unit for the reference speech-to-text server.
#
#   sudo useradd --system --home /opt/vca-stt --shell /usr/sbin/nologin vca-stt
#   sudo -u vca-stt ./install.sh --dir /opt/vca-stt      (as that user)
#   sudo cp vca-stt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vca-stt
#   journalctl -u vca-stt -f
#
# With a GPU, add the service user to the group that owns /dev/nvidia*
# (often "video" or "render") if the device files are not world-accessible.

[Unit]
Description=Speech-to-text server for Voice Command AI (faster-whisper)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vca-stt
Group=vca-stt
WorkingDirectory=/opt/vca-stt
EnvironmentFile=-/opt/vca-stt/stt.env
ExecStart=/opt/vca-stt/run.sh
Restart=on-failure
RestartSec=5
# Loading a large model on first start includes a download.
TimeoutStartSec=600

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/vca-stt/data /opt/vca-stt/hf
ProtectHome=yes
PrivateTmp=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# The GPU needs /dev/nvidia*, so PrivateDevices stays off. On a CPU-only
# server you can turn it on:
# PrivateDevices=yes
# CUDA and some math libraries generate code at run time, so
# MemoryDenyWriteExecute stays off.
# Optional resource limits:
# MemoryMax=16G
# CPUQuota=400%

[Install]
WantedBy=multi-user.target
